# ── AI Provider 선택 ──────────────────────────────────────────────────────────
# openai     : OpenAI를 직접 호출 (기본값, 기존 방식과 동일)
# openrouter : OpenRouter를 통해 Claude 등 다른 모델 호출
#
# STEP 7-2부터는 서버가 OpenRouter의 Web Search Server Tool
# (tools: [{ type: "openrouter:web_search" }])을 여러 검색 모델에 붙여 먼저
# 실제 검색 결과를 수집한 뒤, 분석 모델(AI_ANALYSIS_MODEL)에는 "수집된 자료"만
# 컨텍스트로 전달한다. AI는 검색이 아니라 분석만 수행한다.
AI_PROVIDER=openrouter

# ── OpenRouter 설정 (AI_PROVIDER=openrouter일 때 사용) ────────────────────────
OPENROUTER_API_KEY=

# 최종 분석 모델 (검색 결과를 읽고 communitySummary/uncertainty/fomoRisk를 작성)
AI_ANALYSIS_MODEL=anthropic/claude-sonnet-4
# AI_MODEL은 STEP 7-1 하위호환용 폴백 이름 (AI_ANALYSIS_MODEL 미설정 시 사용)
AI_MODEL=anthropic/claude-sonnet-4

# ── OpenAI 설정 (AI_PROVIDER=openai일 때 사용, 기존 방식 하위호환) ────────────
# gpt-4o                : 일반 GPT (웹 검색 없음, 빠름)
# gpt-4o-search-preview : 웹 검색 지원 GPT (검색 파이프라인 도입 이전 방식과 호환)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-search-preview

# ── 검색 파이프라인 (OpenRouter Web Search Server Tool) ───────────────────────
# 서버가 data/aliases/{gameId}.json 기반으로 검색 대상 이름/키워드를 구성하고,
# 아래 검색 모델들에 openrouter:web_search 툴을 붙여 병렬로 검색을 수행한다.
# 검색 모델은 OpenRouter에서 사용 가능한 모델 ID면 무엇이든 지정 가능하다.
#
# AI_SEARCH_MODELS      : 콤마로 구분된 후보 모델 ID 목록
# AI_SEARCH_MAX_MODELS  : 실제로 호출할 모델 수 (목록 앞에서부터 사용, 비용/속도 제어용)
# AI_SEARCH_ENGINE      : web_search 툴의 engine 파라미터 (기본 auto)
# AI_SEARCH_MAX_RESULTS : 검색 1회당 최대 결과 수
# AI_SEARCH_MAX_TOTAL_RESULTS : 요청 전체 누적 최대 결과 수
#
# 미설정 시(AI_SEARCH_MODELS 비어 있음) 검색 결과 0건으로 처리되어
# uncertainty가 높게 산출된다 (추측으로 채우지 않음).
AI_SEARCH_MODELS=openai/gpt-4o-search-preview,perplexity/sonar
AI_SEARCH_MAX_MODELS=2
AI_SEARCH_ENGINE=auto
AI_SEARCH_MAX_RESULTS=5
AI_SEARCH_MAX_TOTAL_RESULTS=20

# ── Claude Code 로컬 메타 갱신 (신규 "Claude Code로 메타 갱신" 버튼) ──────────
# OpenRouter API 과금이 아니라, 이 컴퓨터에 로그인된 Claude Pro/Max 구독 인증을
# 사용해 로컬 Claude Code CLI를 spawn으로 실행한다. 별도 API 키가 필요 없다 —
# 대신 `claude auth login`으로 이 컴퓨터에 미리 로그인되어 있어야 한다.
#
# CLAUDE_CODE_COMMAND   : claude 실행 파일 이름 (미설정 시 기본값 claude)
# CLAUDE_CODE_MODEL     : claude 세션에 사용할 모델 별칭 (기본 sonnet)
# CLAUDE_CODE_TIMEOUT_MS: 1회 실행 최대 대기 시간(ms), 기본 600000(10분)
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_TIMEOUT_MS=600000

# 서버 포트 (기본값: 3001)
# PORT=3001
